# ============================================================
# Competition Manager - backend en desarrollo local
# ------------------------------------------------------------
# Copia este archivo a backend/.env y ajusta los valores.
# Para el despliegue con Docker/Dokploy usa el .env de la raiz.
# ============================================================

PORT=3001
NODE_ENV=development

# --- Base de datos ---
# El backend crea la base de datos y las tablas al arrancar si no existen;
# basta con que MySQL este levantado y las credenciales sean correctas.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hyrox_db
DB_USER=root
DB_PASSWORD=

# --- Sesiones ---
# Minimo 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# --- CORS ---
# Origen del frontend en desarrollo (Vite).
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=1

# --- Datos iniciales ---
# El administrador solo se crea si la tabla de usuarios esta vacia, y en el
# primer ingreso el sistema obliga a cambiar la contrasena.
SEED_ADMIN_CEDULA=0000000000
SEED_ADMIN_PASSWORD=Admin123!

# Carga un juez, cuatro atletas y un WOD de ejemplo. Util para probar.
SEED_DEMO=true

# --- Consola ---
# Detalle del log: error | warn | info | debug
LOG_LEVEL=info
# Imprime cada consulta SQL. Muy ruidoso, solo para depurar la base de datos.
DB_LOGGING=false

# --- Alta de cuentas y correo saliente ---
# Direccion publica del frontend: se usa para armar el enlace de verificacion.
APP_URL=http://localhost:5173
# Permite que cualquiera cree su cuenta desde la pantalla de acceso.
REGISTRO_ABIERTO=true
# SMTP del correo saliente. Sin SMTP_HOST no se envia nada y el enlace de
# verificacion se escribe en el log del backend (suficiente en desarrollo).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Competition Manager <no-reply@tu-dominio.com>
