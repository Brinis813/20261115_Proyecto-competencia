# ============================================================
# Competition Manager - variables para docker-compose / Dokploy
# ------------------------------------------------------------
# Copia este archivo a .env y rellena los valores.
# En Dokploy, pega este contenido en la pestana "Environment".
# ============================================================

# --- Base de datos ---
# La contrasena de root solo la usa el contenedor de MySQL.
MYSQL_ROOT_PASSWORD=cambia-esta-clave-de-root
MYSQL_DATABASE=hyrox_db
MYSQL_USER=hyrox_user
MYSQL_PASSWORD=cambia-esta-clave-de-usuario

# --- Sesiones ---
# Genera un secreto unico (minimo 32 caracteres) con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Si lo cambias, todas las sesiones abiertas se cierran.
JWT_SECRET=
JWT_EXPIRES_IN=12h

# --- Dominio ---
# Origen exacto desde el que se sirve la aplicacion, con https y sin barra final.
# Acepta varios separados por coma.
CORS_ORIGIN=https://competencia.tudominio.com

# Proxies de confianza delante del backend: nginx del frontend + el de Dokploy.
TRUST_PROXY=2

# --- Administrador inicial ---
# Solo se usa si la base de datos esta vacia. En el primer ingreso el sistema
# obliga a cambiar esta contrasena.
SEED_ADMIN_CEDULA=0000000000
SEED_ADMIN_PASSWORD=CambiaEstaClave123!

# Carga jueces, atletas y una competencia de ejemplo. Dejar en false en produccion.
SEED_DEMO=false

# --- Entornos dev vs prod (área 3: DB segura) ---
# Desarrollo: DB local hyrox_db_dev. Producción: OTRA base y OTRAS credenciales.
# Nunca reutilices MYSQL_PASSWORD de dev en prod, ni ejecutes seeds de dev en prod.
# NODE_ENV=production + SEED_DEMO=true revienta el arranque (ver db/guard.ts).
# ALLOW_SEEDS=true solo para staging efímero, jamás en prod real.
# NODE_ENV=development
# ALLOW_DB_SYNC=false
# ALLOW_SEEDS=false

# --- Monitoreo (área 1, opcional) ---
# Backend: define SENTRY_DSN y ejecuta `npm i @sentry/node` en backend/.
# El frontend NO lleva Sentry en el bundle: reporta a POST /api/errores y el
# backend lo reenvía. Sin DSN solo hay log local estructurado (JSON en prod).
# SENTRY_DSN=

# --- Correo saliente (SMTP genérico: vale Resend/Brevo) ---
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=
# SMTP_FROM=Competition Manager <no-reply@tudominio.com>
# APP_URL=https://competencia.tudominio.com

# --- Puerto publicado ---
# Puerto del host que atiende el frontend. En Dokploy dejalo en 80 y asigna el
# dominio desde su panel; usa otro valor solo si el 80 ya esta ocupado.
FRONTEND_PORT=80
